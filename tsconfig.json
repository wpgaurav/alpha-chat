{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"module": "ESNext",
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"strict": true
	},
	"include": [ "assets/**/*" ]
}
